rules_version = '2';

// Family Finance access rules (PRD 10.2, 10.3).
//
// Layout:
//   users/{uid}                          -> { workspaceId }   which family this person belongs to
//   invites/{email}                      -> { workspaceId, workspaceName, invitedByName, role, invitedBy, createdAt }
//   workspaces/{wid}                     -> { name, createdBy, createdAt, schemaVersion }
//   workspaces/{wid}/members/{uid}       -> { role: admin|member, status, email, displayName, createdAt }
//   workspaces/{wid}/accounts|categories|notes/{id}
//   workspaces/{wid}/transactions/{id}
//   workspaces/{wid}/edits/{entryId}     append-only log of every transaction save
//
// Nothing is ever hard-deleted from the client: records are soft-deleted (deleted = true)
// so deletions sync and history is kept (PRD 1.4.2, 6.5, 9.5).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberDoc(wid) { return /databases/$(db)/documents/workspaces/$(wid)/members/$(me()); }
    function workspaceDoc(wid) { return /databases/$(db)/documents/workspaces/$(wid); }
    function inviteDoc(email) { return /databases/$(db)/documents/invites/$(email); }

    function isMember(wid) {
      return signedIn() && exists(memberDoc(wid)) && get(memberDoc(wid)).data.status == 'active';
    }
    function isAdmin(wid) { return isMember(wid) && get(memberDoc(wid)).data.role == 'admin'; }

    // Fields every family record carries; creator and creation time can never change.
    function stamped() {
      let d = request.resource.data;
      return d.updatedBy == me()
        && d.updatedAt is timestamp
        && d.version is int && d.version >= 1
        && d.deleted is bool
        && (resource == null
              ? d.createdBy == me()
              : d.createdBy == resource.data.createdBy && d.createdAt == resource.data.createdAt);
    }

    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // Money is whole paise (CLAUDE.md, PRD 8.3).
    function validTransaction() {
      let d = request.resource.data;
      return stamped()
        && d.type in ['income', 'expense', 'transfer']
        && d.amountPaise is int && d.amountPaise > 0
        && isDate(d.date)
        && d.title is string
        && (d.type == 'transfer'
              ? d.fromAccountId is string && d.toAccountId is string && d.fromAccountId != d.toAccountId
              : d.accountId is string && d.categoryId is string);
    }

    function validAccount() {
      let d = request.resource.data;
      return stamped()
        && d.name is string && d.name.size() > 0
        && d.openingBalancePaise is int
        && isDate(d.openingBalanceDate)
        && d.isActive is bool;
    }

    function validCategory() {
      let d = request.resource.data;
      return stamped() && d.kind in ['income', 'expense'] && d.name is string && d.isArchived is bool;
    }

    function validNote() {
      let d = request.resource.data;
      return stamped() && d.title is string && d.title.size() > 0 && isDate(d.date);
    }

    match /users/{userId} {
      allow read: if signedIn() && me() == userId;
      // Only point at a family you are (after this write) actually a member of.
      allow create, update: if signedIn() && me() == userId
        && request.resource.data.keys().hasOnly(['workspaceId', 'updatedAt'])
        && existsAfter(/databases/$(db)/documents/workspaces/$(request.resource.data.workspaceId)/members/$(me()));
      allow delete: if false;
    }

    match /invites/{inviteEmail} {
      allow read: if signedIn() && (myEmail() == inviteEmail || isAdmin(resource.data.workspaceId));
      allow create: if isAdmin(request.resource.data.workspaceId)
        && inviteEmail == inviteEmail.lower()
        && request.resource.data.keys().hasOnly(['workspaceId', 'workspaceName', 'invitedByName', 'role', 'invitedBy', 'createdAt'])
        && request.resource.data.role == 'member'
        && request.resource.data.invitedBy == me();
      // The admin may cancel it; the invited person removes it when joining.
      allow delete: if signedIn() && (myEmail() == inviteEmail || isAdmin(resource.data.workspaceId));
      allow update: if false;
    }

    match /workspaces/{wid} {
      allow read: if isMember(wid);
      // Created together with the founder's admin membership, in one batch.
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && getAfter(memberDoc(wid)).data.role == 'admin';
      allow update: if isAdmin(wid) && request.resource.data.createdBy == resource.data.createdBy;
      // Deleting a whole family workspace is not offered in the app (PRD 3.3).
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(wid);
        allow create: if signedIn() && memberId == me()
          && request.resource.data.status == 'active'
          && request.resource.data.email == myEmail()
          && (
            // Founder: the workspace is new in this same batch and names them as creator.
            (request.resource.data.role == 'admin'
              && !exists(workspaceDoc(wid))
              && getAfter(workspaceDoc(wid)).data.createdBy == me())
            ||
            // Invited person: a verified Google email with an invite to this workspace.
            (request.resource.data.role == 'member'
              && request.auth.token.email_verified == true
              && exists(inviteDoc(myEmail()))
              && get(inviteDoc(myEmail())).data.workspaceId == wid)
          );
        // Admin manages others' membership, but cannot lock themselves out.
        allow update, delete: if isAdmin(wid) && memberId != me();
      }

      match /accounts/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && validAccount();
        allow delete: if false;
      }

      match /categories/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && validCategory();
        allow delete: if false;
      }

      match /notes/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && validNote();
        allow delete: if false;
      }

      match /transactions/{id} {
        allow read: if isMember(wid);
        allow create, update: if isMember(wid) && validTransaction();
        allow delete: if false;
      }

      // Every transaction save is also logged here, so edits made on both phones at the
      // same time are never lost (PRD 9.4, 11.5). Append-only.
      match /edits/{entryId} {
        allow read: if isMember(wid);
        allow create: if isMember(wid)
          && request.resource.data.editedBy == me()
          && request.resource.data.transactionId is string
          && request.resource.data.baseVersion is int
          && request.resource.data.version is int
          && request.resource.data.editedAt is timestamp;
        allow update, delete: if false;
      }
    }
  }
}
