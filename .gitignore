firebase/.firebaserc

# Firebase tooling
firebase/node_modules/
firebase/*.log

# Release signing key and its passwords (PRD 16.2: backed up safely, never committed)
keystore.properties
*.jks
*.keystore

# Family backups and exports, in case one is saved inside the project
family-finance-backup*.json
family-finance_*.pdf
family-finance_*.csv
